APP_NAME="FFSET Lounge API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

FRONTEND_URL=https://ffsetlounge.com/
FRONTEND_STORE_URL=http://localhost:3001
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3001

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

ADMIN_EMAIL=admin@ffsetlounge.com
ADMIN_PASSWORD=password

CASHIER_EMAIL=cashier@ffsetlounge.com
CASHIER_PASSWORD=password

# Get test/live keys from https://dashboard.paystack.co/#/settings/developer
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_ORDER_RECEIVED=
WHATSAPP_TEMPLATE_PAYMENT_CONFIRMED=
WHATSAPP_TEMPLATE_PROCESSING=
WHATSAPP_TEMPLATE_READY=
WHATSAPP_TEMPLATE_DISPATCHED=
WHATSAPP_TEMPLATE_DELIVERED=
WHATSAPP_TEMPLATE_CANCELLED=
WHATSAPP_TEMPLATE_REFUNDED=
MARKETPLACE_ORDER_EXPIRY_MINUTES=60

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ffset
DB_USERNAME=ffset
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
